node_modules/
dist/
*.tsbuildinfo
coverage/

# Generated at build time by scripts/write-build-meta.mjs. Recording a commit
# SHA in the repo would be a lie the moment it is committed.
apps/api/build-meta.json

# Local environment and secrets. Never commit .env files.
.env
.env.*
!.env.example

# Runtime state written by the deploy scripts
.run/
*.log

# Transient working notes written into the checkout by the agent runtime.
# Local state, never part of the repository's history.
.paperclip-resume-*.md

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Per-machine agent settings. The runtime regenerates this on every host, and
# the committed copy named internal host paths and agent ids, so it was removed
# from the index before the first push. `--cached` only: the live file stays on
# disk, the repository just stops carrying it.
.claude/settings.local.json
