# Copy to .env for local development. Never commit the real .env.
#
# Every value here has a safe default, so the service runs with an empty .env.
# The deploy scripts generate the real per-environment files from this template.

# Which environment this process believes it is. One of: development, test, staging, production.
DDJ_ENV=development

# Port the HTTP server binds. Staging and production use different ports on the same host.
DDJ_PORT=3000

# Interface to bind. 127.0.0.1 keeps the service off the LAN; use 0.0.0.0 to expose it.
DDJ_HOST=127.0.0.1

# Log verbosity: fatal, error, warn, info, debug, trace.
DDJ_LOG_LEVEL=info

# Postgres connection string. Optional: /health/ready reports readiness as "skipped"
# when this is unset, so the service still runs without a database.
# DDJ_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/ddj
